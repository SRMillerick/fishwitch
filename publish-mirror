#!/usr/bin/env bash
# Public repo has its OWN linear history. Never push private archive history.
# --prepare NEW_DIR produces the exact sanitized HEAD tree without any network.
# --revision-file FILE records the exact public commit published (for deploy.sh).
set -euo pipefail
DIR="$(dirname "$(readlink -f "$0")")"
SRC_SHA="$(git -C "$DIR" rev-parse --short HEAD)"
PUB=git@github.com:SRMillerick/fishwitch.git
MODE=publish
REVISION_FILE=
DEST=
case "${1:-}" in
  '') [[ $# == 0 ]] || exit 2 ;;
  --prepare) [[ $# == 2 ]] || exit 2; MODE=prepare; DEST=$2 ;;
  --revision-file) [[ $# == 2 ]] || exit 2; REVISION_FILE=$(realpath -m "$2") ;;
  *) echo 'Usage: ./publish-mirror [--prepare NEW_DIR | --revision-file FILE]' >&2; exit 2 ;;
esac
if [[ $MODE == publish && -n $(git -C "$DIR" status --porcelain) ]]; then
  echo 'Review and commit the working tree before public mirroring' >&2; exit 1
fi
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
TREE="$WORK/tree"
if [[ $MODE == prepare ]]; then TREE=$DEST; fi
# Refuse existing destinations rather than delete/overwrite anything there.
mkdir "$TREE"
git -C "$DIR" archive HEAD | tar -x -C "$TREE" \
    --exclude=reports --exclude=HANDOFF.md --exclude=STATE.md --exclude=START.md \
    --exclude=ASSOCIATES.md --exclude=submissions --exclude=SEO.md --exclude=COVERAGE.md \
    --exclude=baromoon_prelim_plan.md --exclude=PRODUCT_RESET.md --exclude=config/candidates
"${BAROMOON_PYTHON:-$HOME/.astro-venv/bin/python}" - "$TREE" <<'PY'
import json, sys
from pathlib import Path
root = Path(sys.argv[1])
p = root / 'config/lakes.json'
d = json.loads(p.read_text())
for v in d.values():
    for field in ('lore', 'access', 'structure'):
        v.pop(field, None)
p.write_text(json.dumps(d, indent=2))
# Fail closed if runtime/private paths ever become tracked accidentally.
for name in ('logs', 'reports', 'venv', '.cache', 'config/logbook.jsonl'):
    if (root / name).exists():
        raise SystemExit('Refusing private/runtime path in mirror: ' + name)
profiles = root / 'config/profiles'
if profiles.exists() and any(p.name != 'example.json' for p in profiles.iterdir()):
    raise SystemExit('Refusing non-example profiles in mirror')
PY
cat > "$TREE/PUBLIC-NOTES.md" <<EOF
# Public mirror

Clean public mirror of fishwitch — mirrored from the private development
ledger by \`publish-mirror\` (mirror of archive@$SRC_SHA). Excluded from the
mirror: session docs, generated reports, and home-lake intel. Profiles and
logbooks are gitignored by policy in both repos (identity-grade PII).

Rendered showcase: GitHub Pages (gh-pages branch), built by \`build_static.py\`
(anonymous snapshots only — no profiles, no natal data, no logbook data).
EOF
if [[ $MODE == prepare ]]; then
  echo "Prepared sanitized archive@$SRC_SHA in $TREE (not published)"
  exit 0
fi
git clone -q --single-branch --branch main "$PUB" "$WORK/repo"
# Remove tracked dotfiles too, without touching the cloned .git history.
git -C "$WORK/repo" rm -rq --ignore-unmatch .
cp -r "$TREE"/. "$WORK/repo"/
git -C "$WORK/repo" add -A
if ! git -C "$WORK/repo" diff --cached --quiet; then
  git -C "$WORK/repo" -c user.name="fishwitch mirror bot" -c user.email="noreply@localhost" \
      commit -qm "mirror of archive@$SRC_SHA"
  git -C "$WORK/repo" push -q origin HEAD:main
fi
REVISION=$(git -C "$WORK/repo" rev-parse HEAD)
# A commit failure is no longer mistaken for a successful no-op publication.
if [[ -n $REVISION_FILE ]]; then printf '%s\n' "$REVISION" > "$REVISION_FILE"; fi
echo "Public revision: $REVISION (mirror of archive@$SRC_SHA)"
