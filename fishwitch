#!/bin/sh
# fishwitch — fishing report apparatus (swisseph + kerykeion + requests venv)
DIR="$(dirname "$(readlink -f "$0")")"
if [ "${1-}" = "window" ]; then
    shift
    exec env PYTHONPATH="$(dirname "$DIR")" "$HOME/.astro-venv/bin/python" "$DIR/window_cli.py" "$@"
fi
exec env PYTHONPATH="$(dirname "$DIR")" "$HOME/.astro-venv/bin/python" "$DIR/cli.py" "$@"
